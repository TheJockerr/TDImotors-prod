# Variables de Entorno — TDI Motors
# Copia este archivo como .env y completa los valores reales
# NUNCA subas .env al repositorio Git

# ─────────────────────────────────────────
# SUPABASE (obligatorio)
# ─────────────────────────────────────────

# URL de tu proyecto Supabase
# Formato: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=https://rlruxfqqfqicxisoaevf.supabase.co

# Anon key pública de Supabase (segura para el frontend)
# Encuéntrala en: Supabase Dashboard → Settings → API → anon public
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJscnV4ZnFxZnFpY3hpc29hZXZmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODI3NTY3NjksImV4cCI6MjA5ODMzMjc2OX0.0efUKdN4g_V9mql1G_ST9pkEKHAv1hzXRLy5iJaM0w0

# ─────────────────────────────────────────
# WHATSAPP (obligatorio)
# ─────────────────────────────────────────

# Número principal de WhatsApp (sin +, sin espacios)
# Ejemplo: 56940385580 para +56 9 4038 5580
VITE_WHATSAPP_NUMBER=56940385580

# ─────────────────────────────────────────
# STORAGE (se construye automáticamente desde VITE_SUPABASE_URL)
# ─────────────────────────────────────────

# Nombre del bucket de imágenes en Supabase Storage
# Debe coincidir exactamente con el bucket creado en Supabase Dashboard
VITE_STORAGE_BUCKET=vehicle-images

# ─────────────────────────────────────────
# INSTAGRAM (opcional)
# ─────────────────────────────────────────

VITE_INSTAGRAM_URL=https://www.instagram.com/tdi_motors

# ─────────────────────────────────────────
# NOTAS DE SEGURIDAD
# ─────────────────────────────────────────
# - VITE_SUPABASE_ANON_KEY es pública pero segura: solo permite
#   operaciones autorizadas por las políticas RLS de Supabase.
# - NUNCA uses la service_role key en el frontend.
# - La service_role key solo va en funciones serverless/backend.
# - Los administradores se gestionan en Supabase Auth Dashboard,
#   nunca en este archivo.
